{
  "name": "quickstart-web-js-npm",
  "version": "1.0.0",
  "description": "Quickstart project for DeepAR Web.",
  "main": "index.js",
  "scripts": {
    "dev": "run-p watch ourwebpack",
    "ourwebpack": "webpack --watch --mode development",
    "watch": "nodemon db.js",
    "build": "rm -rf dist && webpack --config webpack.config.js --mode production && cp -r public/* dist && cp -r node_modules/deepar public/deepar-resources"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@babel/preset-env": "^7.26.7",
    "babel-loader": "^9.2.1",
    "express": "^4.21.2",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "webpack": "^5.97.1",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.11.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "deepar": "^5.4.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express-session": "^1.18.1",
    "mongodb": "^6.12.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "validator": "^13.12.0"
  }
