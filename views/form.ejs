  <!--! Get OTP with single OTP input -->

  <script>
    document.addEventListener("DOMContentLoaded", () => {

      const form = document.querySelector("#otp");
      const input = document.querySelector(".otp-input");
      const verifyBtn = document.querySelector("#verifyBtn")

      input.focus();

      if ("OTPCredential" in window) {
        navigator.credentials.get({ otp: { transport: ["sms"] } })
          .then(otp => {
            if (otp && otp.code) {
              fillOTP(otp.code);
            }
          })
          .catch(err => console.error("OTP Auto-fill failed:", err));
      }

      input.setAttribute("autocomplete", "one-time-code");
      input.setAttribute("maxlength", "6");

      const fillOTP = (otp) => {
        input.value = sanitizeOTP(otp);
        toggleFilledClass(input);
        toggleVerifyButton();
        if (input.value.length === 6) input.blur();
      };

      const sanitizeOTP = (otp) => {
        return otp.replace(/[^0-9]/g, "").trim().slice(0, 6);
      };

      const getOTP = () => {
        return sanitizeOTP(input.value);
      };

      const toggleFilledClass = (field) => {
        if (field.value) {
          field.classList.add("filled");
        } else {
          field.classList.remove("filled");
        }
      };

      const toggleVerifyButton = () => {
        if (input.value.length === 6) {
          verifyBtn.removeAttribute("disabled");
          input.blur();
        } else {
          verifyBtn.setAttribute("disabled", "true");
        }
      };

      input.addEventListener("input", () => {
        input.value = sanitizeOTP(input.value);
        toggleFilledClass(input);
        toggleVerifyButton();
      });

      input.addEventListener("paste", (e) => {
        e.preventDefault();
        let text = e.clipboardData.getData("text").replace(/[^0-9]/g, "").trim().slice(0, 6);
        fillOTP(text);
      });

      window.addEventListener("load", () => {
        input.focus();
      });
    });

  </script>

  <script src="main.js"></script>

  </html>