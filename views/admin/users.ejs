<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Users</title>
    <style>
        * {
            font-family: Arial, sans-serif;
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            background-color: #f4f4f4;
            padding: 20px;
        }
        #content {
            width: 80%;
            margin: 0px auto;
        }
        h1 {
            text-align: center;
            margin-bottom: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        th {
            background: #007BFF;
            color: white;
            text-transform: uppercase;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        .img-cell {
            display: flex;
            align-items: center;
        }
        .img-cell span {
            font-size: 12px;
            color: #d1d1d1;
        }
        img {
            margin-right: 4px;
            width: 50px;
            height: 50px;
            border-radius: 8px;
            object-fit: cover;
        }
        .fallback-img {
            background: #ddd;
            width: 50px;
            height: 50px;
            display: inline-block;
            border-radius: 8px;
            text-align: center;
            line-height: 50px;
            font-size: 12px;
            color: #666;
        }
        button {
            background-color: #007BFF;
            color: white;
            border: none;
            padding: 8px 12px;
            cursor: pointer;
            border-radius: 5px;
            transition: 0.3s ease-in-out;
        }
        button:hover {
            background-color: #0056b3;
        }
        .delete-btn {
            background-color: red;
        }
        .delete-btn:hover {
            background-color: darkred;
        }
        .loading {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background: #fff;
            font-size: 20px;
            font-weight: bold;
            color: #555;
        }
        .hidden {
            display: none;
        }
    </style>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("loading").classList.add("hidden");
            document.getElementById("content").classList.remove("hidden");
        });

        function handleImageError(img) {
            img.src = "";
            img.classList.add("fallback-img");
            img.alt = "No Image";
            img.innerHTML = "No Image";
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString() + " " + date.toLocaleTimeString();
        }
    </script>
</head>
<body>
    <div id="loading" class="loading">Loading...</div>
    <div id="content" class="hidden">
        <h1>Users List</h1>
        <p class="user-count">Total Users: <strong><%= totalUsers %></strong></p>
        <table>
            <tr>
                <th>Phone</th>
                <th>Age</th>
                <th>Registered Date</th>
                <th>Profile Images</th>
                <th>Actions</th>
            </tr>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.phone %></td>
                    <td><%= user.age %></td>
                    <td><script>document.write(formatDate('<%= user.registeredDate %>'));</script></td>
                    <td class="img-cell">
                        <% if (user.profileImages && user.profileImages.length > 0) { %>
                            <% 
                                // Create a reversed copy of the profile images array
                                let reversedImages = user.profileImages.slice().reverse(); 
                            %>
                            <% reversedImages.slice(0, 3).forEach(image => { %>
                                <img src="<%= image %>" alt="Profile Image" onerror="handleImageError(this)">
                            <% }) %>
                            <% if (user.profileImages.length > 3) { %>
                                <span>+<%= user.profileImages.length - 3 %> more</span>
                            <% } %>
                        <% } else { %>
                            <div class="fallback-img">No Image</div>
                        <% } %>
                    </td>
                    <td>
                        <form action="/admin/users/<%= user._id %>" method="GET">
                            <button type="submit">View</button>
                        </form> 
                        <!-- | <form action="/admin/users/delete/<%= user._id %>" method="POST" style="display:inline;">
                            <button type="submit" class="delete-btn" onclick="return confirm('Are you sure?');">Delete</button>
                        </form> -->
                    </td>
                </tr>
            <% }) %>
        </table>
    </div>
</body>
</html>
