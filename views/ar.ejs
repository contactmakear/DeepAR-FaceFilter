      <div id="share-screen" class="fixed-fullscreen">
        <!-- close icon -->

        <img class="heart-top-right" src="images/heart-top-right.png" alt="Hearts">
        <img class="heart-top-left" src="images/heart-top-left.png" alt="Hearts">
        <img class="heart-bottom-left" src="images/bottom-left-heart.png" alt="Hearts">
