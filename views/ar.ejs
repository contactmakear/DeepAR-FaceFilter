<!DOCTYPE html>
<html lang="en-us">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0"
    />
    <title>DeepAR Web SDK - Face and body AR in the browser</title>
    <link rel="stylesheet" href="style.css" />
  </head>

  <body>

    <!-- loading screen -->
    <div class="fixed-fullscreen" id="loading-screen">
      <div
        style="
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
        "
      >
        <img
          id="initial-loading-logo"
          style="max-width: 200px"
          src="./images/crystal.png"
          class="animate-bounce"
        />
        <div
          style="
            width: 100%;
            height: 8px;
            margin-top: 20px;
            background-color: rgb(55 65 81 / 1);
            border-radius: 100px;
            overflow: hidden;
          "
        >
          <div id="loading-progress-bar"></div>
        </div>
        <img
          id="initial-loading-text"
          style="max-width: 140px; margin-top: 30px"
          src="./images/powered-by.svg"
        />
      </div>
    </div>

    <!-- permission denied screen -->
    <div
      class="fixed-fullscreen screen"
      id="permission-denied-screen"
      style="display: none"
    >
      <div class="permission-denied-text-container">
        <div class="permission-denied-text" id="camera_denied">
          <p>Please reload and allow camera access to use this app.</p>
          <a
            class="permission-denied-button"
            href="https://www.deepar.ai/projects"
            target="__blank"
          >
            Discover more
          </a>
        </div>
      </div>
    </div>
  

  


    <!-- AR screen -->
    <div class="fixed-fullscreen screen" id="ar-screen" style="display: none">

      <form style="position: absolute; top: 0px; right: 0px;" class="logout-button" action="/logout" method="POST">
        <button>LOGOUT</button>
      </form>
      <!-- <canvas class="deepar" id="deepar-canvas"></canvas> -->
      <div class="button-slider">
        <div class="slides active" data-category="slide1">
          <img class="responsive-img" width="80%" height="80%" src="thumbs/icon/Ellipse_1.png" />
        </div>
        <div class="slides" data-category="slide2">
          <img class="responsive-img" width="80%" height="80%" src="thumbs/icon/Ellipse_2.png" />
        </div>
      </div>
      <div
      id="toolbar"
      style="
        z-index: 200;
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        width: 100%;
        display: flex;
        justify-content: center;
        flex-direction: column;
      "
    >
     
      <!-- toolbar -->
      <div class="carousel" id="carousel">
        <div class="carousel-center" id="carousel-center">
          <div class="lds-ring" id="loading-spinner" style="display: none">
            <div></div>
            <div></div>
            <div></div>
            <div></div>
          </div>
        </div>
        <div class="carousel-slider">
          <div class="slide">
            <img class="responsive-img" src="thumbs/icon/glass1.png" />
          </div>
          <div class="slide">
            <img class="responsive-img" src="thumbs/icon/glasses02.png" />
          </div>
          <div class="slide">
            <img class="responsive-img" src="thumbs/icon/glasses03.png" />
          </div>
          <div class="slide">
            <img class="responsive-img" src="thumbs/icon/glasses04.png" />
          </div>
          <div class="slide">
            <img class="responsive-img" src="thumbs/icon/glasses5.png" />
          </div>
          <div class="slide">
            <img class="responsive-img" src="thumbs/icon/cap9.png" />
          </div>
          <div class="slide">
            <img class="responsive-img" src="thumbs/icon/cap10.png" />
          </div>
          <div class="slide">
            <img class="responsive-img" src="thumbs/icon/cap11.png" />
          </div>
          <div class="slide">
            <img class="responsive-img" src="thumbs/icon/cap12.png" />
          </div>
          <div class="slide">
            <img class="responsive-img" src="thumbs/icon/cap13.png" />
          </div>
        
         
        </div>
      </div>
      <div
      id="share-screen"
      class="fixed-fullscreen"
      style="
        background-color: black;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
      display: none;"
    >
      <!-- close icon -->
      <div
        id="close-share-screen"
        class="no-select"
        style="
          position: absolute;
          top: 1rem;
          right: 1rem;
          color: white;
          cursor: pointer;
          z-index: 300;
          background-color: black;
          border-radius: 100%;
          width: 3rem;
          height: 3rem;
          display: flex;
          justify-content: center;
          align-items: center;
        "
      >
        <img
          src="images/interface-delete.svg"
          style="width: 1.5rem; height: 1.5rem"
        />
      </div>
      <div id="share-image-container" style=" display: flex; justify-content: center; flex-grow: 1; max-height: 86%; width: 100%; "></div>
      <div
        style="
          background-color: black;
          padding: 0.6rem;
          display: flex;
          justify-content: center;
          align-items: center;
          height: 60px;
          width: 100%;
        "
      >
     
      </div>
    </div>
  
     </div>
    </div>

    <script type="text/javascript" src="main.js"></script>
  </body>
</html>
